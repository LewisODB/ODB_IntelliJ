<idea-plugin url="https://github.com/LewisODB/ODB_IntelliJ">
    <id>org.lewisodb</id>
    <name>Lewis ODB</name>
    <vendor url="https://github.com/LewisODB/ODB_IntelliJ">Lewis ODB</vendor>
    <version>0.1.0-SNAPSHOT</version>
    <idea-version since-build="252" until-build="261.*"/>
    <change-notes>https://github.com/LewisODB/ODB_IntelliJ/blob/main/CHANGELOG.md</change-notes>
    <description><![CDATA[
        <p>Run the selected local Java Application configuration with the bundled Lewis Omniscient Debugger.</p>
        <p>ODB remains in separate Swing windows. The plugin does not modify the project or saved run configuration.</p>
        <p>Version 1 supports classpath applications running on a local JDK 8.</p>
        <p>Report problems through <a href="https://github.com/LewisODB/ODB_IntelliJ/issues">GitHub Issues</a>.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.java</depends>
    <resource-bundle>messages.OdbBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <executor implementation="org.lewisodb.intellij.execution.OdbExecutor"/>
        <programRunner implementation="org.lewisodb.intellij.execution.OdbProgramRunner"/>
        <backgroundPostStartupActivity implementation="org.lewisodb.intellij.lifecycle.OdbRecoveryStartupActivity"/>
        <notificationGroup id="Lewis ODB" displayType="BALLOON" isLogByDefault="true"/>
    </extensions>
</idea-plugin>
